# Copy to .env.local for development; set the same keys in the Vercel project
# settings (Settings -> Environment Variables) for production.
#
# Nothing here is secret — .env.local is git-ignored, this file is not.
# Verify the whole path end to end with `npm run check:email`.

# From https://resend.com/api-keys. Without this the form refuses to submit and
# tells the visitor to email directly, rather than silently dropping the enquiry.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries land. Defaults to contact.email in src/data/site.ts.
# Deliberately NOT the address shown on the site: visitors are told to email
# sera@claudecode.sg, while form submissions route to Larry.
ENQUIRY_TO=larry@macrostudios.sg

# The address enquiries are sent FROM. Must be on a domain verified at
# https://resend.com/domains, otherwise Resend returns 403.
#
# This is NOT the enquirer's address, and cannot be: sending as someone else's
# domain fails SPF/DKIM and gets filed as spam. Their address goes into Reply-To
# automatically, so replying from the inbox still reaches them. Their *name* is
# used as the From display name — enquiries arrive as "Jane Tan via Macrostudios".
#
# If no domain is verified yet, Resend's shared sandbox sender works with no DNS:
#   ENQUIRY_FROM=onboarding@resend.dev
# but it only delivers to the address that owns the Resend account, so ENQUIRY_TO
# must be that address while testing.
ENQUIRY_FROM=sera@claudecode.sg
