# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and documents what must be set.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scraped originals from the old WordPress site (~243 MB).
# Kept locally so `npm run images` can be re-run; never committed.
/scripts/raw/*
# ...with one exception: the brand master. Every logo, icon and share card on the
# site is derived from that single file by `npm run brand`, so unlike the scraped
# photography it has to survive a fresh clone.
!/scripts/raw/brand/

# Build/verification artefacts
/scripts/tmp/
/scripts/shots/
